/* ---------- API 호출 ---------- */
let routeIdx=0;
async function callApi(base,endpoint,params){
 const key=getKey();
 if(!key)throw new Error("API 키가 없습니다. 상단에서 키를 입력하세요.");
 const p=new URLSearchParams({serviceKey:key,resultType:"json",...params});
 const target=`${base}${endpoint}?${p}`;
 const order=[routeIdx,...ROUTES.map((_,i)=>i).filter(i=>i!==routeIdx)];
 const logs=[];
 for(const idx of order){
  const r=ROUTES[idx];
  try{
   const text=await(await fetch(r.wrap(target))).text();
   let d;try{d=JSON.parse(text)}catch{logs.push(`[${r.name}] JSON 아님: ${text.slice(0,100)}`);continue}
   const h=d?.response?.header||d?.header,body=d?.response?.body||d?.body;
   if(h&&h.resultCode!=="00")throw Object.assign(new Error(`${h.resultMsg} (코드 ${h.resultCode})`),{fatal:true});
   routeIdx=idx;$("route").textContent="호출 경로: "+r.name;
   return{body};
  }catch(e){if(e.fatal)throw e;logs.push(`[${r.name}] ${e.message}`)}
 }
 throw new Error("모든 경로 실패\n"+logs.join("\n"));
}
async function fetchAll(ep,crno,year){
 let page=1,total=0;const items=[];
 do{
  const{body}=await callApi(FIN_BASE,ep,{crno,bizYear:year,pageNo:page,numOfRows:200});
  total=Number(body?.totalCount||0);
  const it=toArray(body?.items?.item);
  items.push(...it);if(!it.length)break;page++;
 }while(items.length<total&&page<=10);
 return items;
}

