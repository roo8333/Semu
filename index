function hBars(rows){
 const v=rows.filter(r=>r.value!==null);
 if(!v.length)return`<div class="empty">데이터 없음</div>`;
 const max=Math.max(...v.map(r=>Math.abs(r.value)))||1;
 return v.map(r=>`<div class="hb"><div class="l">${esc(r.label)}</div><div class="t"><b class="${r.value<0?"n":""}" style="width:${Math.max(1,Math.abs(r.value)/max*100)}%"></b></div><div class="v ${r.value<0?"neg":""}">${fmtShort(r.value)}</div></div>`).join("");
}
function donut(parts,top,bottom){
 const ps=parts.filter(p=>p.value!==null&&p.value>0),total=ps.reduce((s,p)=>s+p.value,0);
 if(!total)return`<div class="empty">데이터 없음</div>`;
 let off=25;
 const arcs=ps.map((p,i)=>{const len=p.value/total*100;const c=`<circle cx="21" cy="21" r="15.915" fill="none" stroke="${PALETTE[i%8]}" stroke-width="6" stroke-dasharray="${len} ${100-len}" stroke-dashoffset="${off}"></circle>`;off-=len;return c}).join("");
 const center=top?`<text x="21" y="21" text-anchor="middle" font-size="5.5" font-weight="700">${esc(top)}</text><text x="21" y="26.5" text-anchor="middle" font-size="3" fill="#999">${esc(bottom||"")}</text>`:"";
 const legend=ps.map((p,i)=>`<div><i style="background:${PALETTE[i%8]}"></i>${esc(p.label)} ${(p.value/total*100).toFixed(1)}% (${fmtShort(p.value)})</div>`).join("");
 return`<div class="donutwrap"><svg viewBox="0 0 42 42"><circle cx="21" cy="21" r="15.915" fill="none" stroke="#f0ece4" stroke-width="6"></circle>${arcs}${center}</svg><div class="legend">${legend}</div></div>`;
}
function columnChart(series,cats){
 const all=cats.flatMap(c=>c.vals).filter(v=>v!==null);
 if(!all.length)return`<div class="empty">데이터 없음</div>`;
 const W=600,H=240,pL=8,pR=8,pT=22,pB=38;
 const max=Math.max(0,...all),min=Math.min(0,...all),span=(max-min)||1;
 const y=v=>pT+(max-v)/span*(H-pT-pB),y0=y(0);
 const gw=(W-pL-pR)/cats.length,bw=Math.min(34,(gw*.72)/series.length);
 let svg=`<line x1="${pL}" x2="${W-pR}" y1="${y0}" y2="${y0}" stroke="#d5d0c4"/>`;
 cats.forEach((c,ci)=>{
  const gx=pL+gw*ci+(gw-bw*series.length)/2;
  c.vals.forEach((v,si)=>{
   if(v===null)return;
   const x=gx+bw*si,yy=y(v),top=Math.min(yy,y0),h=Math.max(1,Math.abs(yy-y0));
   svg+=`<rect x="${x}" y="${top}" width="${bw-2}" height="${h}" fill="${v<0?"#a8442a":PALETTE[si%8]}"><title>${esc(c.label)} ${esc(series[si].name)}: ${fmtWon(v)}</title></rect><text x="${x+(bw-2)/2}" y="${v>=0?top-4:top+h+11}" text-anchor="middle" font-size="10" fill="#6b665c">${fmtShort(v)}</text>`;
  });
  svg+=`<text x="${pL+gw*ci+gw/2}" y="${H-16}" text-anchor="middle" font-size="11" fill="#6b665c">${esc(c.label.length>9?c.label.slice(0,9)+"…":c.label)}</text>`;
 });
 const legend=series.length>1?`<div class="legend">${series.map((s,i)=>`<span><i style="background:${PALETTE[i%8]}"></i>${esc(s.name)}</span>`).join("")}</div>`:"";
 return`<svg viewBox="0 0 ${W} ${H}">${svg}</svg>${legend}`;
}
