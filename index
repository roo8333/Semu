<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>CAREER LEDGER · 구직자용 기업 재무 분석</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@200;300;400;500&family=Cormorant+Garamond:wght@400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
:root{--ink:#1a1a1a;--line:#e4e0d8;--sub:#8a857b;--or:#f37021;--bg:#faf8f5;--moss:#3f5d4a;--rust:#a8442a}
body{margin:0;font-family:"Noto Sans KR","Helvetica Neue",sans-serif;font-weight:300;background:var(--bg);color:var(--ink);letter-spacing:.02em}
.hidden{display:none!important}
.hero{position:relative;height:340px;color:#fff;display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:22px 32px;background:linear-gradient(180deg,rgba(0,0,0,.18),rgba(0,0,0,0) 40%),radial-gradient(ellipse at 15% 100%,rgba(28,58,40,.95),transparent 55%),radial-gradient(ellipse at 85% 95%,rgba(55,90,65,.9),transparent 50%),linear-gradient(180deg,#cfd8d1 0%,#9fb2a5 45%,#3f5d4a 100%)}
.hero .bar{width:100%;font-size:13px;letter-spacing:.12em}
.hero a{color:#fff;text-decoration:none;cursor:pointer}
.hero .logo{position:absolute;left:50%;top:22px;transform:translateX(-50%);text-align:center;font-family:"Cormorant Garamond",serif;font-size:30px;letter-spacing:.35em;font-weight:500;white-space:nowrap}
.hero .logo small{display:block;font-family:"Noto Sans KR",sans-serif;font-size:10px;letter-spacing:.5em;margin-top:4px}
.hero nav{display:flex;gap:26px;flex-wrap:wrap;justify-content:center;font-size:12px;letter-spacing:.14em}
.hero nav a{padding-bottom:4px;border-bottom:1px solid transparent}
.hero nav a:hover{border-color:#fff}
.hero nav .sep{opacity:.6}
.wrap{max-width:980px;margin:0 auto;padding:40px 20px 100px}
.lead{text-align:center;color:var(--sub);font-size:13px;letter-spacing:.1em;margin:0 0 28px}
.keybar{border:1px solid var(--line);background:#fff;padding:12px 16px;margin-bottom:22px;font-size:12px;color:var(--sub)}
.keybar summary{cursor:pointer}
.keybar .row{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.keybar input{flex:1;min-width:220px;padding:10px 12px;font-size:14px;border:1px solid var(--line)}
form{display:flex;border-bottom:1px solid var(--ink)}
input,select{padding:14px 4px;font:inherit;font-size:16px;border:0;border-radius:0;outline:none;background:transparent;color:var(--ink)}
input{flex:1;min-width:200px}
button.search{padding:0 26px;font:inherit;font-size:12px;letter-spacing:.2em;border:0;background:var(--ink);color:#fff;cursor:pointer}
button.search:hover{background:var(--or)}
button.search:disabled{background:#aaa}
#status{margin:20px 0 14px;color:var(--sub);font-size:13px}
#route{font-size:11px;color:var(--sub)}
.error{color:var(--rust)!important;white-space:pre-wrap}
.card,.dhead,.verdict,.draft,.bullets,details.fold,.metric,.kpi,.chart,.tablebox,.sig{background:#fff;border:1px solid var(--line);border-radius:0}
.card{padding:22px 24px;margin-bottom:14px}
.card:hover{border-color:var(--ink)}
.top,.backrow{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.name{font-family:"Cormorant Garamond","Noto Sans KR",serif;font-size:24px;font-weight:500}
.en{color:var(--sub);font-size:12px;margin-top:3px}
.right{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.crno{font-size:15px;letter-spacing:.12em}
.btn-sm{border:1px solid var(--ink);background:#fff;color:var(--ink);padding:9px 16px;border-radius:0;cursor:pointer;font:inherit;font-size:11px;letter-spacing:.16em}
.btn-sm:hover{background:var(--ink);color:#fff}
.btn-sm.primary{background:var(--or);border-color:var(--or);color:#fff}
.btn-sm.primary:hover{background:var(--ink);border-color:var(--ink)}
.cmeta{margin-top:14px;padding-top:12px;border-top:1px solid var(--line);font-size:13px;color:#6b665c;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:5px 16px}
.badge{display:inline-block;border:1px solid var(--or);color:var(--or);font:400 10px "Noto Sans KR";letter-spacing:.12em;padding:2px 8px;margin-left:10px;vertical-align:middle}
#more{width:100%;padding:15px;margin-top:6px;border:1px solid var(--ink);background:#fff;font:inherit;font-size:12px;letter-spacing:.2em;cursor:pointer}
#more:hover{background:var(--ink);color:#fff}
.backrow{margin-bottom:16px}
.dhead{padding:22px 24px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.dhead select{padding:8px 4px;font-size:15px;border-bottom:1px solid var(--ink)}
.meta{font-size:12px;color:var(--sub);margin:10px 0}
.chips{display:flex;gap:8px;margin:14px 0;flex-wrap:wrap}
.chip{padding:6px 14px;border:1px solid var(--line);background:#fff;cursor:pointer;font:inherit;font-size:12px}
.chip:hover{border-color:var(--ink)}
.chip.active{background:var(--ink);color:#fff;border-color:var(--ink)}
.sec-title{font-family:"Cormorant Garamond","Noto Sans KR",serif;font-size:20px;font-weight:500;letter-spacing:.12em;margin:36px 0 14px}
.empty{padding:40px;text-align:center;color:var(--sub);line-height:1.8}
.loadnote{font-size:11px;color:var(--sub);margin-top:8px}
.sig-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.sig{padding:16px 18px;border-left:3px solid var(--line)}
.sig.g{border-left-color:var(--moss)}.sig.y{border-left-color:#c9a24a}.sig.r{border-left-color:var(--rust)}
.sig .sl{font-size:11px;color:var(--sub)}
.sig .sv{font-size:24px;font-weight:200;margin:6px 0}
.sig .sd{font-size:12px;color:#6b665c;line-height:1.6}
.verdict{padding:22px 24px;font-size:15px;line-height:1.8;margin-top:6px;border-top:2px solid var(--or)}
.bullets{padding:16px 24px 16px 40px;font-size:14px;line-height:1.9;margin:0}
.draft{padding:18px 22px;font-size:14px;line-height:1.9;margin-bottom:8px}
.draft .btn-sm{margin-top:10px}
.links a{display:inline-block;margin:0 8px 8px 0;padding:9px 16px;background:#fff;border:1px solid var(--ink);color:var(--ink);text-decoration:none;font-size:11px}
.links a:hover{background:var(--ink);color:#fff}
details.fold{margin-top:14px;padding:4px 20px}
details.fold>summary{cursor:pointer;padding:14px 0;font-size:12px;letter-spacing:.16em;font-weight:500}
details.fold[open]>summary{border-bottom:1px solid var(--line);margin-bottom:14px}
details.fold .bullets{border:0;padding-left:20px}
details.fold .inner{padding-bottom:16px}
.tabs{display:flex;gap:30px;margin:4px 0 18px;border-bottom:1px solid var(--line);overflow-x:auto}
.tab{padding:10px 0;border:0;background:none;font:inherit;font-size:12px;letter-spacing:.18em;cursor:pointer;color:var(--sub);border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap}
.tab.active{color:var(--ink);border-bottom-color:var(--or);font-weight:500}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.metric,.kpi,.chart{padding:18px 20px}
.metric .label,.kpi .label{font-size:11px;color:var(--sub)}
.metric .value{font-size:20px;font-weight:200;margin-top:8px}
.metric .raw{font-size:11px;color:#aaa;margin-top:3px}
.kpi .value{font-size:24px;font-weight:200;margin:6px 0 10px}
.gauge{height:3px;background:#efeae0}.gauge b{display:block;height:100%;background:var(--ink)}
.tablebox{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:11px 16px;border-bottom:1px solid #f0ece4;white-space:nowrap}
th{text-align:right;color:var(--sub);font-weight:400;font-size:11px}
th:first-child,td:first-child{text-align:left;white-space:normal}
td.n{text-align:right;font-variant-numeric:tabular-nums}
.neg{color:var(--rust)}.pos{color:var(--moss)}
.unit{text-align:right;font-size:11px;color:var(--sub);margin-bottom:8px}
.charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}
.chart.wide{grid-column:1/-1}
.chart h4{margin:0 0 14px;font-size:12px;font-weight:500;letter-spacing:.16em}
.chart svg{width:100%;height:auto;display:block}
.legend{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:10px;font-size:11px;color:#6b665c}
.legend i{display:inline-block;width:9px;height:9px;margin-right:5px}
.hb{display:grid;grid-template-columns:110px 1fr 90px;align-items:center;gap:8px;margin-bottom:8px;font-size:12px}
.hb .l{color:#6b665c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hb .t{background:#f3efe7;height:10px;overflow:hidden}
.hb .t b{display:block;height:100%;background:var(--ink)}.hb .t b.n{background:var(--rust)}
.hb .v{text-align:right}
.donutwrap{display:flex;align-items:center;gap:18px;flex-wrap:wrap;justify-content:center}
.donutwrap svg{width:150px;flex:none}.donutwrap .legend{flex-direction:column;margin:0}
textarea{width:100%;padding:12px;font:inherit;font-size:13px;border:1px solid var(--line);border-radius:0;resize:vertical;background:#fff;color:var(--ink);margin-bottom:10px}
.lb{display:block;font-size:11px;letter-spacing:.12em;color:var(--sub);margin:6px 0}
.hl{background:#fff;border:1px solid var(--line);border-left:3px solid var(--or);padding:14px 18px;margin-bottom:10px;font-size:14px;line-height:1.7}
.tg{display:inline-block;font-size:10px;letter-spacing:.14em;border:1px solid var(--ink);padding:1px 7px;margin-right:8px}
.kwc{display:inline-block;font-size:11px;background:var(--or);color:#fff;padding:1px 8px;margin:4px 4px 0 0}
.typebox{background:var(--ink);color:#fff;padding:16px 22px;margin:14px 0;font-size:14px;line-height:1.8}
.typebox b{font-family:"Cormorant Garamond","Noto Sans KR",serif;font-size:22px;letter-spacing:.08em;margin-right:10px}
.fab{position:fixed;right:24px;bottom:24px;z-index:50;background:var(--or);color:#fff;border:0;padding:15px 24px;font:inherit;font-size:12px;letter-spacing:.2em;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.25)}
.fab:hover{background:var(--ink)}
.cmask{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:60;display:none;align-items:center;justify-content:center;padding:16px}
.cmask.on{display:flex}
.phone{position:relative;width:340px;max-width:100%;height:640px;max-height:94vh;background:#111;border-radius:42px;padding:12px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.phone:before{content:"";position:absolute;top:12px;left:50%;transform:translateX(-50%);width:110px;height:22px;background:#111;border-radius:0 0 16px 16px;z-index:3}
.screen{width:100%;height:100%;background:var(--bg);border-radius:32px;overflow:hidden;display:flex;flex-direction:column}
.ph-top{padding:34px 20px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);background:#fff}
.ph-top b{font-family:"Cormorant Garamond",serif;font-size:17px;letter-spacing:.2em;font-weight:500}
.ph-x{border:0;background:none;font-size:20px;cursor:pointer}
.ph-bar{height:3px;background:var(--line)}.ph-bar i{display:block;height:100%;background:var(--or);width:0;transition:width .3s}
.ph-body{flex:1;overflow-y:auto;padding:22px 20px}
.ph-body h3{margin:0 0 6px;font-size:17px;font-weight:500}
.ph-body p{margin:0 0 16px;font-size:12px;color:var(--sub);line-height:1.6}
.pc{display:block;width:100%;text-align:left;background:#fff;border:1px solid var(--line);padding:16px;margin-bottom:10px;cursor:pointer;font:inherit}
.pc:hover{border-color:var(--ink)}
.pc.sel{border-color:var(--or);border-left:4px solid var(--or)}
.pc b{display:block;font-size:14px;font-weight:500;margin-bottom:3px}
.pc span{font-size:11px;color:var(--sub)}
.ph-in{width:100%;border:0;border-bottom:1px solid var(--ink);padding:12px 2px;font-size:16px;margin-bottom:8px;background:transparent}
.ph-msg{width:100%;border:1px solid var(--line);padding:10px;font:inherit;font-size:13px;margin-top:6px;resize:none;background:#fff}
.ph-err{color:var(--rust);font-size:11px;min-height:16px}
.ph-foot{padding:12px 20px 20px;display:flex;gap:8px;border-top:1px solid var(--line);background:#fff}
.ph-foot button{flex:1;padding:13px;border:1px solid var(--ink);background:#fff;font:inherit;font-size:11px;letter-spacing:.16em;cursor:pointer}
.ph-foot .go{background:var(--ink);color:#fff}
.ph-foot .go:hover{background:var(--or);border-color:var(--or)}
.ph-foot button:disabled{opacity:.4;cursor:not-allowed}
.ph-sum{background:#fff;border:1px solid var(--line);padding:14px;font-size:12px;line-height:1.9;margin-bottom:12px}
.ph-agree{font-size:11px;color:var(--sub);line-height:1.6}
.ph-ok{text-align:center;padding-top:70px}
.ph-ok i{display:block;font-style:normal;font-size:46px;color:var(--moss);margin-bottom:12px}
@media(max-width:600px){.hero{height:300px;padding:16px}.hero .logo{font-size:20px}.hero nav{gap:14px}}
</style>
</head>
<body>
<header class="hero">
  <div class="bar"><a onclick="goSearch()">검색</a></div>
  <div class="logo">CAREER LEDGER<small>FINANCE FOR JOB SEEKERS</small></div>
  <nav>
    <a onclick="goSearch()">기업 검색</a><span class="sep">|</span>
    <a onclick="var k=document.getElementById('keybar');k.open=true;k.scrollIntoView({behavior:'smooth'})">API 키</a>
    <a href="https://www.data.go.kr" target="_blank" rel="noopener">데이터 출처</a>
    <a href="https://dart.fss.or.kr/" target="_blank" rel="noopener">DART</a>
  </nav>
</header>
<div class="wrap">
  <p class="lead">기업을 검색하면 "이 회사, 지원해도 될까?"에 필요한 정보를 먼저 보여줍니다</p>
  <details class="keybar" id="keybar">
    <summary id="keyState">API 키 설정</summary>
    <div class="row">
      <input id="keyInput" type="password" placeholder="공공데이터포털 일반 인증키 붙여넣기" autocomplete="off" />
      <button class="btn-sm primary" id="keySave" type="button">저장</button>
      <button class="btn-sm" id="keyClear" type="button">삭제</button>
    </div>
    <div class="loadnote">키는 이 브라우저(localStorage)에만 저장되며 코드에는 들어 있지 않습니다.</div>
  </details>

  <div id="searchView">
    <form id="form">
      <input id="q" placeholder="기업명 예) 삼성전자" autocomplete="off" autofocus />
      <button class="search" id="btn" type="submit">검색</button>
    </form>
    <div id="status"></div><div id="list"></div>
    <button id="more" class="hidden">더 보기</button>
  </div>

  <div id="detailView" class="hidden">
    <div class="backrow"><button class="btn-sm" id="back">← 검색 결과로</button><span id="route"></span></div>
    <div class="dhead"><div><div class="name" id="dName"></div><div class="en" id="dSub"></div></div><select id="year"></select></div>
    <div id="dStatus" class="meta"></div>
    <div id="chips" class="chips"></div>
    <details class="fold" id="ctxBox" open>
      <summary>맞춤 입력 (선택) · 채용공고 / 내 경험</summary>
      <div class="inner">
        <label class="lb">채용공고 (담당업무·자격요건·우대사항 붙여넣기)</label>
        <textarea id="posting" rows="5" placeholder="공고 텍스트를 붙여넣으면 키워드를 찾아 직무 추천과 맞춤 분석에 반영합니다"></textarea>
        <label class="lb">내 경험 (한 줄에 하나씩, 2~3개)</label>
        <textarea id="myexp" rows="3" placeholder="예) 전산회계 1급 취득&#10;학교 동아리 회계 담당, 월 결산 엑셀 정리"></textarea>
        <button class="btn-sm primary" id="ctxApply" type="button">맞춤 분석 적용</button>
        <button class="btn-sm" id="ctxClear" type="button">입력 지우기</button>
        <div class="loadnote">입력한 경험은 이 브라우저에만 저장됩니다. 공고는 기업을 바꾸면 비워집니다.</div>
      </div>
    </details>
    <div id="fitPanel"></div>
    <details class="fold" id="rawBox">
      <summary>상세 재무제표 · 차트 (펼쳐서 보기)</summary>
      <div class="tabs">
        <button class="tab active" data-tab="summ">요약</button>
        <button class="tab" data-tab="bs">재무상태표</button>
        <button class="tab" data-tab="is">손익계산서</button>
      </div>
      <div id="panel"></div>
    </details>
  </div>
</div>

<button class="fab" id="fab" type="button">상담하기</button>
<div class="cmask" id="cmask">
  <div class="phone"><div class="screen">
    <div class="ph-top"><b>CONSULT</b><button class="ph-x" id="phX" type="button">✕</button></div>
    <div class="ph-bar"><i id="phBar"></i></div>
    <div class="ph-body" id="phBody"></div>
    <div class="ph-foot" id="phFoot"></div>
  </div></div>
</div>

<script>
const CORP_BASE="https://apis.data.go.kr/1160100/service/GetCorpBasicInfoService_V2/";
const FIN_BASE="https://apis.data.go.kr/1160100/service/GetFinaStatInfoService_V2/";
const ENDPOINTS={summ:"getSummFinaStat_V2",bs:"getBs_V2",is:"getIncoStat_V2"};
const ROWS_PER_PAGE=30,YEAR_SCAN=8,TREND_YEARS=5;
const JOBS=["회계","세무","재무","경영지원"];
const ICON={g:"🟢",y:"🟡",r:"🔴",n:"⚪"};
const ROUTES=[
 {name:"직접 호출",wrap:u=>u},
 {name:"corsproxy.io",wrap:u=>"https://corsproxy.io/?url="+encodeURIComponent(u)},
 {name:"allorigins",wrap:u=>"https://api.allorigins.win/raw?url="+encodeURIComponent(u)}];
const SUMM_FIELDS=[["enpSaleAmt","매출액"],["enpBzopPft","영업이익"],["enpCrtmNpf","당기순이익"],["iclsPalClcAmt","포괄손익"],["enpTastAmt","총자산"],["enpTdbtAmt","총부채"],["enpTcptAmt","총자본"],["enpCptlAmt","자본금"]];
const AMT_COLS=[["crtmAcitAmt","당기"],["pvtrAcitAmt","전기"],["bpvtrAcitAmt","전전기"],["thqrAcitAmt","당분기"],["lsqtAcitAmt","전분기"]];
const PALETTE=["#2b2b2b","#3f5d4a","#8a9a8c","#f37021","#cbb994","#8a7d6b","#a8442a","#6b8a9a"];

/* ---------- 유틸 ---------- */
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmtCrno=v=>v&&v.length===13?`${v.slice(0,6)}-${v.slice(6)}`:(v||"-");
const fmtBzno=v=>v&&v.length===10?`${v.slice(0,3)}-${v.slice(3,5)}-${v.slice(5)}`:(v||"-");
const fmtDate=v=>v&&v.length===8?`${v.slice(0,4)}-${v.slice(4,6)}-${v.slice(6)}`:(v||"-");
const toNum=v=>(v===""||v==null||isNaN(Number(v)))?null:Number(v);
const fmtWon=n=>n.toLocaleString("ko-KR");
const fmtBig=n=>{const a=Math.abs(n);if(a>=1e12)return(n/1e12).toFixed(2)+"조 원";if(a>=1e8)return Math.round(n/1e8).toLocaleString("ko-KR")+"억 원";return n.toLocaleString("ko-KR")+" 원"};
const fmtShort=n=>{const a=Math.abs(n),s=n<0?"-":"";if(a>=1e12)return s+(a/1e12).toFixed(1)+"조";if(a>=1e8)return s+Math.round(a/1e8).toLocaleString("ko-KR")+"억";if(a>=1e4)return s+Math.round(a/1e4).toLocaleString("ko-KR")+"만";return n.toLocaleString("ko-KR")};
const money=v=>v==null?"-":fmtBig(v);
const toArray=x=>Array.isArray(x)?x:(x?[x]:[]);
const pct=(a,b)=>(a==null||b==null||b===0)?null:(a/b)*100;
const fmtPct=v=>v==null?"-":v.toLocaleString("ko-KR",{maximumFractionDigits:1})+"%";
const norm=s=>String(s||"").replace(/\s+/g,"");

/* ---------- API 키 ---------- */
const getKey=()=>{let k=(localStorage.getItem("fin_api_key")||"").trim();if(k.includes("%")){try{k=decodeURIComponent(k)}catch{}}return k};
function refreshKeyState(){
 const has=!!getKey();
