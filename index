 if(lossYears>=2)pts.push(`최근 3년 중 ${lossYears}년 영업적자입니다. 적자 원인(일시적/구조적)을 파악하세요.`);
 if(cur.bzop>0&&cur.npf<0)pts.push("영업이익은 흑자인데 순손실입니다. 이자비용, 평가손실, 일회성 비용을 확인하세요.");
 if(cur.bzop<0&&cur.npf>0)pts.push("영업적자인데 순이익은 흑자입니다. 자산매각이익 등 일회성 이익일 수 있습니다.");
 if(growth!==null&&growth<-10)pts.push(`매출이 전년 대비 ${fmtPct(growth)} 감소했습니다. 사업 축소 여부를 확인하세요.`);
 if(icr!==null&&icr<1)pts.push("이자보상배율이 1 미만입니다. 자금 조달 구조가 부담일 수 있습니다.");
 if(borrow!==null&&curRto!==null&&curRto<100&&borrow>0)pts.push("유동비율이 100% 미만이고 차입금이 있습니다. 단기 상환 일정을 확인하세요.");
 if(!pts.length)pts.push("눈에 띄는 위험 신호는 자동 탐지되지 않았습니다. 주석과 현금흐름은 DART에서 확인하세요.");
 const caution=`<ul class="bullets">${pts.map(p=>`<li>${esc(p)}</li>`).join("")}</ul>`;

 const years=[];for(let y=base-TREND_YEARS+1;y<=base;y++)years.push(y);
 const mk=(title,fields)=>chartBox(title,columnChart(fields.map(([,n])=>({name:n})),years.map(y=>{const r=pickY(y);return{label:`${y}`,vals:fields.map(([k])=>r?toNum(r[k]):null)}})),true);
 const loadingTrend=Object.keys(my.trend).length<TREND_YEARS;
 const trendHtml=`<div class="charts">${mk("손익 추이",[["enpSaleAmt","매출액"],["enpBzopPft","영업이익"],["enpCrtmNpf","당기순이익"]])}${mk("재무 규모 추이",[["enpTastAmt","총자산"],["enpTdbtAmt","총부채"],["enpTcptAmt","총자본"]])}</div>${loadingTrend?`<div class="loadnote">다른 연도 데이터를 불러오는 중...</div>`:""}`;
 const enc=encodeURIComponent;
 const links=`<div class="links"><a target="_blank" rel="noopener" href="https://dart.fss.or.kr/">DART 공시</a><a target="_blank" rel="noopener" href="https://www.google.com/search?q=${enc(nm+" 신입 채용")}">채용공고 검색</a><a target="_blank" rel="noopener" href="https://www.google.com/search?q=${enc(nm+" 평균 연봉 근속연수")}">연봉·근속 검색</a><a target="_blank" rel="noopener" href="https://www.google.com/search?q=${enc(nm+" 최근 뉴스")}">최근 뉴스</a></div>`;
 const loadNote=(!bs||!is)?`<div class="loadnote">상세 재무제표를 불러오는 중이면 일부 지표가 "-"로 보일 수 있습니다.</div>`:"";

 return`${verdict}
 <div class="sec-title">이 회사의 핵심 포인트 (${my.job} 직무 기준)</div>${kwBox}${hlHtml}
 <div class="sec-title">핵심 신호등</div><div class="sig-grid">${signals}</div>${loadNote}
 <div class="sec-title">주의해서 볼 포인트</div>${caution}
 <div class="sec-title">지원 직무 선택</div><div class="chips">${jobBtns}</div>${jobTable}
 <div class="sec-title">자소서 문장 초안</div>${drafts}${draftNote}
 ${fold("q","맞춤 면접 질문",qHtml)}
 ${fold("trend",`최근 ${TREND_YEARS}년 추이`,trendHtml)}
 ${fold("links","API에 없는 정보 확인 링크",links)}`;
}

/* ===== 4) 상세 재무제표 ===== */
function renderChips(groups){
 const names=[...groups.keys()];
 if(names.length<2){$("chips").innerHTML="";return}
 $("chips").innerHTML=`<span class="meta" style="align-self:center">재무제표 구분:</span>`+names.map(n=>`<button class="chip ${n===fin.group?"active":""}" data-group="${esc(n)}">${esc(n)}</button>`).join("");
}
function kpiCard(label,v,max,note){
 const w=v===null?0:Math.min(100,Math.max(0,Math.abs(v)/max*100));
 return`<div class="kpi"><div class="label">${label}</div><div class="value ${v!==null&&v<0?"neg":""}">${fmtPct(v)}</div><div class="gauge"><b style="width:${w}%;${v!==null&&v<0?"background:#a8442a":""}"></b></div>${note?`<div style="font-size:11px;color:#aaa;margin-top:4px">${note}</div>`:""}</div>`;
}
function renderSummary(items){
 const rows=groupByType(items).get(fin.group)||items;
 return rows.map(i=>{
  const sale=toNum(i.enpSaleAmt),bzop=toNum(i.enpBzopPft),npf=toNum(i.enpCrtmNpf),tast=toNum(i.enpTastAmt),tdbt=toNum(i.enpTdbtAmt),tcpt=toNum(i.enpTcptAmt);
  const cards=SUMM_FIELDS.filter(([k])=>toNum(i[k])!==null).map(([k,label])=>{const n=toNum(i[k]);return`<div class="metric"><div class="label">${label}</div><div class="value ${n<0?"neg":""}">${fmtBig(n)}</div><div class="raw">${fmtWon(n)} 원</div></div>`}).join("");
  const kpis=[kpiCard("영업이익률",pct(bzop,sale),30),kpiCard("순이익률",pct(npf,sale),30),kpiCard("ROE",pct(npf,tcpt),30),kpiCard("ROA",pct(npf,tast),15),kpiCard("부채비율",tcpt>0?pct(tdbt,tcpt):null,300,"낮을수록 안정적"),kpiCard("자기자본비율",pct(tcpt,tast),100,"높을수록 안정적")].join("");
  const donutHtml=(tdbt!==null&&tcpt!==null&&tdbt>=0&&tcpt>0)?chartBox("자금 조달 구조 (부채 vs 자본)",donut([{label:"부채",value:tdbt},{label:"자본",value:tcpt}],fmtPct(pct(tdbt,tcpt)),"부채비율")):"";
  const barHtml=chartBox("손익·재무 규모",hBars([{label:"매출액",value:sale},{label:"영업이익",value:bzop},{label:"당기순이익",value:npf},{label:"총자산",value:tast},{label:"총부채",value:tdbt},{label:"총자본",value:tcpt}]));
  return`<p class="meta">기준일 ${esc(i.basDt||"-")} · ${esc(i.fnclDcdNm||"")}</p><div class="grid">${kpis}</div><div class="sec-title">규모 차트</div><div class="charts">${barHtml}${donutHtml}</div><div class="sec-title">상세 수치</div><div class="grid">${cards}</div>`;
 }).join("<br>");
}
const KEY_ACCTS={
 bs:[["자산총계",["자산총계","자산계"]],["유동자산",["유동자산"]],["비유동자산",["비유동자산"]],["부채총계",["부채총계","부채계"]],["자본총계",["자본총계","자본계"]]],
 is:[["매출액",["매출액","영업수익","수익(매출액)"]],["매출총이익",["매출총이익"]],["영업이익",["영업이익","영업손익"]],["세전이익",["법인세비용차감전순이익","법인세차감전"]],["당기순이익",["당기순이익","당기순손익","당기순이익(손실)"]]]};
function renderStatement(items,tab){
 const groups=groupByType(items);
 const rows=groups.get(fin.group)||[...groups.values()][0];
 const cols=AMT_COLS.filter(([k])=>rows.some(r=>r[k]!==""&&r[k]!=null));
 if(!cols.length)return`<div class="empty">표시할 금액 항목이 없습니다.</div>`;
 const found=KEY_ACCTS[tab].map(([label,pats])=>({label,row:findAcct(rows,pats)})).filter(x=>x.row);
 const cmpCols=cols.slice(0,3);
 const cmp=found.length?chartBox("주요 계정 기간별 비교",columnChart(cmpCols.map(([,n])=>({name:n})),found.map(f=>({label:f.label,vals:cmpCols.map(([k])=>toNum(f.row[k]))}))),true):"";
 let comp="";
 if(tab==="bs"){
  const v=pats=>{const r=findAcct(rows,pats);return r?toNum(r[cols[0][0]]):null};
  comp+=chartBox("자산 구성",donut([{label:"유동자산",value:v(["유동자산"])},{label:"비유동자산",value:v(["비유동자산"])}]));
  comp+=chartBox("부채·자본 구성",donut([{label:"부채",value:v(["부채총계","부채계"])},{label:"자본",value:v(["자본총계","자본계"])}]));
 }
 const mainKey=cols[0][0];
 const maxAbs=Math.max(1,...rows.map(r=>Math.abs(toNum(r[mainKey])??0)));
 const showChg=cols.length>=2;
 const head=`<tr><th>계정과목</th>${cols.map(([,l])=>`<th>${l}</th>`).join("")}${showChg?"<th>증감률</th>":""}</tr>`;
 const body=rows.map(r=>{
  const tds=cols.map(([k],idx)=>{
   const n=toNum(r[k]);
   if(n===null)return`<td class="n">-</td>`;
   if(idx===0){const w=Math.abs(n)/maxAbs*100,color=n<0?"rgba(168,68,42,.16)":"rgba(243,112,33,.14)";return`<td class="n ${n<0?"neg":""}" style="background-image:linear-gradient(${color},${color});background-repeat:no-repeat;background-position:left center;background-size:${w}% 60%">${fmtWon(n)}</td>`}
   return`<td class="n ${n<0?"neg":""}">${fmtWon(n)}</td>`;
  }).join("");
  let chg="";
  if(showChg){
   const c=toNum(r[cols[0][0]]),p=toNum(r[cols[1][0]]);
   if(c===null||p===null||p===0)chg=`<td class="n">-</td>`;
   else{const rate=(c-p)/Math.abs(p)*100;chg=`<td class="n ${rate>0?"pos":rate<0?"neg":""}">${rate>0?"▲":rate<0?"▼":""} ${Math.abs(rate).toLocaleString("ko-KR",{maximumFractionDigits:1})}%</td>`}
  }
  return`<tr><td>${esc(r.acitNm||"-")}</td>${tds}${chg}</tr>`;
 }).join("");
 return`<div class="charts">${cmp}${comp}</div><div class="sec-title">상세 표</div><div class="unit">단위: 원 ${rows[0].basDt?"(기준일 "+esc(rows[0].basDt)+")":""}</div><div class="tablebox"><table>${head}${body}</table></div>`;
}
function setTab(t){document.querySelectorAll(".tab").forEach(b=>b.classList.toggle("active",b.dataset.tab===t))}
function renderRaw(){
 const t=fin.tab;
 if(fin.errors[t])return`<div class="empty error">오류: ${esc(fin.errors[t])}</div>`;
 const items=fin.data[t];
 if(!items)return`<div class="empty">불러오는 중...</div>`;
 if(!items.length)return`<div class="empty">${fin.year}년 데이터가 없습니다.</div>`;
 return t==="summ"?renderSummary(items):renderStatement(items,t);
}

/* ===== 5) 전체 렌더 ===== */
function render(){
 if(!fin)return;
 if(fin.finding){$("chips").innerHTML="";$("fitPanel").innerHTML=`<div class="empty">재무 데이터를 찾는 중...</div>`;$("panel").innerHTML="";return}
 const g=fin.data.summ?groupByType(fin.data.summ):new Map();
 if(g.size&&(!fin.group||!g.has(fin.group)))fin.group=[...g.keys()][0];
 renderChips(g);
 $("fitPanel").innerHTML=renderFit();
 $("panel").innerHTML=$("rawBox").open?renderRaw():"";
}

/* ===== 6) 이벤트 ===== */
$("form").addEventListener("submit",e=>{e.preventDefault();loadCompanies(true)});
$("more").addEventListener("click",()=>loadCompanies(false));
$("list").addEventListener("click",e=>{
 const pick=e.target.closest("[data-pick]");if(!pick)return;
 const c=[...search.companies.values()].find(x=>x.crno===pick.dataset.pick);
 if(c)selectCompany(c);
});
$("back").addEventListener("click",()=>{fin=null;showView("search")});
$("year").addEventListener("change",()=>{
 if(!fin||fin.finding)return;
 fin.year=$("year").value;
 fin.data={};fin.errors={};fin.loading={};fin.trend={};fin.trendStarted=false;
 $("dStatus").textContent=`${fin.year}년 사업연도 기준`;
 render();loadTab("summ").then(()=>{if(fin)loadAll(fin)});
});
$("chips").addEventListener("click",e=>{
 const c=e.target.closest(".chip");if(!c||!fin)return;
 fin.group=c.dataset.group;render();
});
document.querySelector(".tabs").addEventListener("click",e=>{
 const b=e.target.closest(".tab");if(!b||!fin)return;
 fin.tab=b.dataset.tab;setTab(fin.tab);loadTab(fin.tab);render();
});
$("rawBox").addEventListener("toggle",()=>{if(!fin)return;if($("rawBox").open)loadTab(fin.tab);render()});
$("fitPanel").addEventListener("click",async e=>{
 const j=e.target.closest("[data-job]");
 if(j&&fin){fin.job=j.dataset.job;render();return}
 const c=e.target.closest("[data-copytext]");
 if(c){
  try{await navigator.clipboard.writeText(c.dataset.copytext);const old=c.textContent;c.textContent="복사됨 ✓";setTimeout(()=>(c.textContent=old),1200)}
  catch{alert("복사 실패")}
 }
});
$("fitPanel").addEventListener("toggle",e=>{
 const d=e.target.closest("details[data-k]");
 if(d&&fin)fin.open[d.dataset.k]=d.open;
},true);

/* ===== 7) 맞춤 입력 ===== */
$("myexp").value=localStorage.getItem("my_exp")||"";
$("ctxApply").onclick=()=>{
 localStorage.setItem("my_exp",$("myexp").value);
 if(!fin||fin.finding)return;
 const k=kwScan($("posting").value);
 if(k.job)fin.job=k.job;
 render();
};
$("ctxClear").onclick=()=>{
 $("posting").value="";$("myexp").value="";localStorage.removeItem("my_exp");
 if(fin&&!fin.finding)render();
};

/* ===== 8) 상담하기 위젯 ===== */
const MAIL_TO="tmfrl8333@gmail.com";
const PURPOSES=[
 {k:"세무 회계 상담",d:"세무·회계 관련 궁금한 점"},
 {k:"이 사이트 기능 상담",d:"사용법, 오류, 개선 제안"},
 {k:"사이트 주인에게 문의",d:"그 외 제휴·기타 문의"}];
let cs={step:0,purpose:"",phone:"",email:"",msg:"",sending:false};
function csOpen(){cs={step:0,purpose:"",phone:"",email:"",msg:"",sending:false};$("cmask").classList.add("on");csRender()}
function csClose(){$("cmask").classList.remove("on")}
function csRender(){
 const b=$("phBody"),f=$("phFoot");
 $("phBar").style.width=(cs.step>=4?100:cs.step*25+25)+"%";
 if(cs.step===0){
  b.innerHTML=`<h3>어떤 상담을 원하세요?</h3><p>목적을 선택해 주세요.</p>`+PURPOSES.map((p,i)=>`<button class="pc ${cs.purpose===p.k?"sel":""}" data-p="${i}"><b>${p.k}</b><span>${p.d}</span></button>`).join("");
  f.innerHTML=`<button class="go" id="n0" ${cs.purpose?"":"disabled"}>다음</button>`;
  b.querySelectorAll(".pc").forEach(x=>x.onclick=()=>{cs.purpose=PURPOSES[x.dataset.p].k;csRender()});
  $("n0").onclick=()=>{cs.step=1;csRender()};
 }else if(cs.step===1){
  b.innerHTML=`<h3>연락받을 전화번호</h3><p>선택 사항입니다. 건너뛰어도 됩니다.</p><input class="ph-in" id="inPh" type="tel" inputmode="numeric" placeholder="010-0000-0000" value="${esc(cs.phone)}"><div class="ph-err" id="er"></div>`;
  f.innerHTML=`<button id="bk">이전</button><button id="sk">건너뛰기</button><button class="go" id="nx">다음</button>`;
  $("bk").onclick=()=>{cs.step=0;csRender()};
  $("sk").onclick=()=>{cs.phone="";cs.step=2;csRender()};
  $("nx").onclick=()=>{
   const v=$("inPh").value.trim();
   if(v&&!/^[0-9\-\s+]{9,15}$/.test(v)){$("er").textContent="전화번호 형식을 확인해 주세요.";return}
   cs.phone=v;cs.step=2;csRender()};
 }else if(cs.step===2){
  b.innerHTML=`<h3>이메일 주소</h3><p>답변을 받을 이메일을 입력해 주세요.</p><input class="ph-in" id="inEm" type="email" placeholder="name@example.com" value="${esc(cs.email)}"><textarea class="ph-msg" id="inMsg" rows="4" placeholder="문의 내용 (선택)">${esc(cs.msg)}</textarea><div class="ph-err" id="er"></div>`;
  f.innerHTML=`<button id="bk">이전</button><button class="go" id="nx">다음</button>`;
  $("bk").onclick=()=>{cs.email=$("inEm").value;cs.msg=$("inMsg").value;cs.step=1;csRender()};
  $("nx").onclick=()=>{
   const v=$("inEm").value.trim();
   if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)){$("er").textContent="올바른 이메일 주소를 입력해 주세요.";return}
   cs.email=v;cs.msg=$("inMsg").value.trim();cs.step=3;csRender()};
 }else if(cs.step===3){
  b.innerHTML=`<h3>내용을 확인해 주세요</h3><div class="ph-sum"><b>목적</b> ${esc(cs.purpose)}<br><b>전화</b> ${esc(cs.phone||"(미입력)")}<br><b>이메일</b> ${esc(cs.email)}<br><b>내용</b> ${esc(cs.msg||"(없음)")}</div><div class="ph-agree">확인을 누르면 위 내용이 사이트 운영자에게 이메일로 전송됩니다. 입력하신 연락처는 상담 회신 목적으로만 사용되며, 전송 과정에서 외부 메일 전송 서비스(FormSubmit)를 거칩니다.</div><div class="ph-err" id="er"></div>`;
  f.innerHTML=`<button id="bk">이전</button><button class="go" id="ok">확인</button>`;
  $("bk").onclick=()=>{cs.step=2;csRender()};
  $("ok").onclick=csSend;
 }else{
  b.innerHTML=`<div class="ph-ok"><i>✓</i><h3>접수되었습니다</h3><p>남겨주신 이메일로 답변드리겠습니다.</p></div>`;
  f.innerHTML=`<button class="go" id="cl">닫기</button>`;$("cl").onclick=csClose;
 }
}
async function csSend(){
 if(cs.sending)return;cs.sending=true;
 const ok=$("ok");ok.disabled=true;ok.textContent="전송 중...";
 try{
  const res=await fetch("https://formsubmit.co/ajax/"+MAIL_TO,{
   method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},
   body:JSON.stringify({_subject:`[상담요청] ${cs.purpose}`,_template:"table",_captcha:"false",목적:cs.purpose,전화번호:cs.phone||"(미입력)",이메일:cs.email,내용:cs.msg||"(없음)",_replyto:cs.email})});
  const j=await res.json().catch(()=>({}));
  if(!res.ok||j.success==="false")throw new Error(j.message||"전송 실패");
  cs.step=4;csRender();
 }catch(e){
  cs.sending=false;ok.disabled=false;ok.textContent="확인";
  $("er").textContent="전송에 실패했습니다: "+e.message+" (웹에 올린 상태에서 첫 활성화 메일 승인이 필요합니다)";
 }
}
$("fab").onclick=csOpen;
$("phX").onclick=csClose;
$("cmask").addEventListener("click",e=>{if(e.target.id==="cmask")csClose()});

refreshKeyState();
</script>
