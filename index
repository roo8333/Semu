function groupByType(items){
 const m=new Map();
 for(const i of items){const k=i.fnclDcdNm||"재무제표";if(!m.has(k))m.set(k,[]);m.get(k).push(i)}
 return m;
}
async function findLatestYear(my){
 const start=new Date().getFullYear()-1;
 try{
  for(let y=start;y>start-YEAR_SCAN;y--){
   if(my!==fin)return;
   $("dStatus").textContent=`데이터가 있는 최근 사업연도를 찾는 중... (${y}년 확인)`;
   const items=await fetchAll(ENDPOINTS.summ,my.crno,y);
   if(my!==fin)return;
   if(items.length){
    my.year=y;my.data.summ=items;my.trend[y]=items;
    my.group=[...groupByType(items).keys()][0];fillYearOptions(y);
    $("dStatus").textContent=`${y}년 사업연도 기준 (데이터가 있는 최신 연도)`;return;
   }
  }
  my.year=start;my.data.summ=[];fillYearOptions(start);
  $("dStatus").textContent=`최근 ${YEAR_SCAN}년 내 요약 재무 데이터가 없습니다. 비상장·소규모 법인은 제공되지 않는 경우가 많으니 DART 감사보고서를 확인하세요.`;
 }catch(e){
  if(my!==fin)return;
  my.year=start;my.errors.summ=e.message;$("dStatus").textContent="";
 }finally{
  if(my===fin){my.finding=false;render();if(my.data.summ?.length)loadAll(my)}
 }
}
function loadAll(my){loadTrend(my);loadTab("bs");loadTab("is")}
async function loadTrend(my){
 if(my.trendStarted||!my.year)return;
 my.trendStarted=true;
 const base=Number(my.year);
 for(let y=base;y>base-TREND_YEARS;y--){
  if(my!==fin)return;
  if(!(y in my.trend)){try{my.trend[y]=await fetchAll(ENDPOINTS.summ,my.crno,y)}catch{my.trend[y]=[]}}
  if(my!==fin)return;
  render();
 }
}
async function loadTab(t){
 if(!fin||fin.finding||fin.data[t]||fin.loading[t])return;
 const my=fin,yr=my.year;my.loading[t]=true;
 try{
  const items=await fetchAll(ENDPOINTS[t],my.crno,yr);
  if(my!==fin||my.year!==yr)return;
  my.data[t]=items;
  if(t==="summ"){my.trend[yr]=items;if(!my.group&&items.length)my.group=[...groupByType(items).keys()][0]}
 }catch(e){if(my!==fin)return;my.errors[t]=e.message}
 finally{my.loading[t]=false;if(my===fin)render()}
}

